{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docx-workflow-state.schema.json",
  "title": "DOCX Workflow State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workflow_id",
    "created_at",
    "updated_at",
    "mode",
    "status",
    "current_stage",
    "required_stages",
    "artifacts",
    "stage_results",
    "issues",
    "next_actions"
  ],
  "properties": {
    "workflow_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["single_skill", "full_workflow"]},
    "status": {"type": "string", "enum": ["draft", "in_progress", "blocked", "failed", "complete"]},
    "current_stage": {
      "type": "string",
      "enum": ["intake", "research_compliance", "design", "plan", "render", "lint", "edit", "compose", "critique", "handoff"]
    },
    "required_stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["intake", "research_compliance", "design", "plan", "render", "lint", "edit", "compose", "critique", "handoff"]
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "stage_results": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "summary"],
        "properties": {
          "status": {"type": "string", "enum": ["pending", "running", "pass", "revise", "reject", "blocked", "failed", "skipped"]},
          "summary": {"type": "string"},
          "agent": {"type": "string", "minLength": 1},
          "artifact_keys": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "completed_at": {"type": "string"},
          "critic_status": {"type": "string", "enum": ["pass", "revise", "reject"]},
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "stage", "message"],
        "properties": {
          "severity": {"type": "string", "enum": ["info", "warning", "error", "blocker"]},
          "stage": {"type": "string"},
          "message": {"type": "string", "minLength": 1},
          "artifact_key": {"type": "string"},
          "path": {"type": "string"}
        }
      }
    },
    "next_actions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
