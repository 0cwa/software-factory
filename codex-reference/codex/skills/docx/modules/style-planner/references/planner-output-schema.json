{
  "$schema": "https://json-schema.org/draft-07/schema",
  "title": "DocxStylePlan",
  "type": "object",
  "required": ["phase", "document_plan", "confidence"],
  "properties": {
    "phase": { "type": "string", "enum": ["intake", "final"] },
    "style_manifest_ref": { "type": ["string", "null"] },
    "research_profile_ref": { "type": ["string", "null"] },
    "document_plan": {
      "type": "object",
      "required": ["title", "document_type", "audience", "purpose", "delivery_mode", "compliance", "sections"],
      "properties": {
        "title": { "type": "string" },
        "document_type": { "type": "string", "enum": ["invoice", "contract", "proposal", "report", "policy", "letter", "brief", "other"] },
        "audience": { "type": "string" },
        "purpose": { "type": "string" },
        "delivery_mode": { "type": "string", "enum": ["screen", "print", "pdf", "mixed"] },
        "toc_required": { "type": "boolean" },
        "compliance": {
          "type": "object",
          "required": ["research_required", "research_status", "verified_at", "jurisdiction", "verified_organization_profile", "invoice_requirements", "source_urls", "unsupported_claims", "forbidden_sections"],
          "properties": {
            "research_required": { "type": "boolean" },
            "research_status": { "type": "string", "enum": ["not_required", "required_missing", "complete", "partial"] },
            "verified_at": { "type": ["string", "null"], "format": "date-time" },
            "legal_domain": { "type": ["string", "null"] },
            "jurisdiction": {
              "type": "object",
              "required": ["country", "region", "basis"],
              "properties": {
                "country": { "type": ["string", "null"] },
                "region": { "type": ["string", "null"] },
                "locality": { "type": ["string", "null"] },
                "basis": { "type": "string" }
              }
            },
            "verified_organization_profile": {
              "type": "object",
              "required": ["legal_entity_name", "registered_address", "source_urls"],
              "properties": {
                "legal_entity_name": { "type": ["string", "null"] },
                "trading_name": { "type": ["string", "null"] },
                "registered_address": { "type": ["string", "null"] },
                "mailing_address": { "type": ["string", "null"] },
                "official_website": { "type": ["string", "null"] },
                "registration_ids": { "type": "array", "items": { "type": "string" } },
                "tax_ids": { "type": "array", "items": { "type": "string" } },
                "source_urls": { "type": "array", "items": { "type": "string" } }
              }
            },
            "invoice_requirements": {
              "type": "object",
              "required": ["applicable", "required_fields", "tax_fields", "payment_fields", "one_page_default", "signature_line_allowed"],
              "properties": {
                "applicable": { "type": "boolean" },
                "required_fields": { "type": "array", "items": { "type": "string" } },
                "tax_fields": { "type": "array", "items": { "type": "string" } },
                "payment_fields": { "type": "array", "items": { "type": "string" } },
                "one_page_default": { "type": "boolean" },
                "signature_line_allowed": { "type": "boolean" },
                "signature_line_basis": { "type": "string" }
              }
            },
            "source_urls": { "type": "array", "items": { "type": "string" } },
            "unsupported_claims": { "type": "array", "items": { "$ref": "#/definitions/unsupportedClaim" } },
            "forbidden_sections": { "type": "array", "items": { "$ref": "#/definitions/forbiddenSection" } }
          }
        },
        "sections": {
          "type": "array",
          "items": { "$ref": "#/definitions/sectionNode" }
        },
        "footnote_rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "handoff": {
      "type": "object",
      "properties": {
        "next_skill": { "type": "string" },
        "required_contract": { "type": "string" },
        "render_instructions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] }
  },
  "definitions": {
    "sectionNode": {
      "type": "object",
      "required": ["id", "type", "order", "label", "style_token"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["hero", "section_intro", "section_body", "metric_block", "insight_box", "callout_box", "table_block", "figure_block", "quote_block", "invoice_summary", "invoice_line_items", "payment_terms", "tax_summary", "appendix"] },
        "order": { "type": "integer", "minimum": 1 },
        "label": { "type": "string" },
        "style_token": { "type": "string" },
        "heading": { "type": "string" },
        "body": { "type": "string" },
        "required_by": { "type": "string", "enum": ["user", "source", "document_type", "style", "optional"] },
        "source_urls": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "children": { "type": "array", "items": { "$ref": "#/definitions/sectionNode" } }
      }
    },
    "unsupportedClaim": {
      "type": "object",
      "required": ["claim", "reason"],
      "properties": {
        "claim": { "type": "string" },
        "reason": { "type": "string" },
        "resolution": { "type": "string" }
      }
    },
    "forbiddenSection": {
      "type": "object",
      "required": ["section", "reason"],
      "properties": {
        "section": { "type": "string" },
        "reason": { "type": "string" },
        "source_url": { "type": ["string", "null"] }
      }
    }
  }
}
