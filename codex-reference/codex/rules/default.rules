# Portable command-approval rules derived from the local Codex rules.
# User- and machine-specific paths, credential access, and secret-bearing
# commands are intentionally omitted or replaced with placeholders.

prefix_rule(pattern=["flatpak-spawn", "--host", "ls"], decision="allow")
prefix_rule(pattern=["flatpak-spawn", "--host", "journalctl"], decision="allow")
prefix_rule(pattern=["flatpak-spawn", "--host", "pgrep"], decision="allow")
prefix_rule(pattern=["flatpak-spawn", "--host", "flatpak"], decision="allow")
prefix_rule(pattern=["flatpak-spawn", "--host", "distrobox"], decision="allow")
prefix_rule(pattern=["node", "--check", "scripts/grist-phase1-implementation.js"], decision="allow")
prefix_rule(pattern=["node", "scripts/grist-phase1-implementation.js"], decision="allow")
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["sha256sum"], decision="allow")
prefix_rule(pattern=["flatpak-spawn", "--host"], decision="allow")
prefix_rule(pattern=["cd", "<USER_HOME>/Dev/ultimatevocalremovergui-rocm"], decision="allow")
prefix_rule(pattern=["git", "add", "lib/config.sh", "main.sh"], decision="allow")
prefix_rule(pattern=["git", "status", "--short"], decision="allow")
prefix_rule(pattern=["git", "add", "lib/bootstrap.sh"], decision="allow")
prefix_rule(pattern=["git", "commit", "-m", "Port bootstrap to Python 3.12 with resilient toolchain setup"], decision="allow")
prefix_rule(pattern=["git", "log", "--oneline", "--decorate", "-n", "5"], decision="allow")
prefix_rule(pattern=["git", "branch", "pr/distrobox-image-fallback", "34f3d44"], decision="allow")
prefix_rule(pattern=["git", "branch", "--show-current"], decision="allow")
prefix_rule(pattern=["git", "checkout", "-b", "pr/bootstrap-python312", "74fb8b8"], decision="allow")
prefix_rule(pattern=["git", "add", "UVR.py", "gui_data/app_size_values.py"], decision="allow")
prefix_rule(pattern=["git", "status", "-sb"], decision="allow")
prefix_rule(pattern=["git", "checkout", "--theirs", "lib/bootstrap.sh"], decision="allow")
prefix_rule(pattern=["cd", "<USER_HOME>/Dev/dj-factory"], decision="allow")
prefix_rule(pattern=["rm", "-rf", "scripts/__pycache__", "scripts/lib/__pycache__"], decision="allow")
prefix_rule(pattern=["git", "add", "manifests/profiles/default.yaml", "schemas/manifest-validation.md", "scripts/content", "scripts/daw-setup", "scripts/plugins", "scripts/verify-safe-checks", "scripts/capabilities.py", "scripts/lib/__init__.py", "scripts/lib/yaml_subset.py"], decision="allow")
prefix_rule(pattern=["git", "commit", "-m", "Add shared manifest tooling foundations"], decision="allow")
prefix_rule(pattern=["git", "add", ".gitignore", "scripts/content", "scripts/lib/yaml_subset.py", "scripts/plugins", "scripts/verify-safe-checks"], decision="allow")
prefix_rule(pattern=["git", "commit", "-m", "Share plugin YAML loader and add content JSON reports"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
